      "icon": "cap",
      "unit": "percent",
      "target": 90,
      "targetLabel": "≥ 90%",
      "direction": "above",
      "formula": "Passed student–course enrollments ÷ enrollments with finalized pass/fail outcomes × 100.",
      "title": "Course outcomes need attention",
      "action": "Review course and year-level outcomes; plan appropriate academic support.",
      "context": "Counts course outcomes, not unique students. Missing, incomplete and withdrawn records are excluded and must be disclosed in a production report."
    },
    {
      "id": "onTimeRate",
      "label": "On-time grade submission",
      "icon": "clock",
      "unit": "percent",
      "target": 95,
      "targetLabel": "≥ 95%",
      "direction": "above",
      "formula": "Sections with complete final grades submitted by the applicable deadline ÷ sections whose deadline has passed × 100.",
      "title": "Grade submission needs follow-up",
      "action": "Check overdue sections and approved deadline exceptions before follow-up.",
      "context": "A complete submission after the deadline remains late. All grades in this scenario are now finalized; the timeliness record is retained."
    },
    {
      "id": "responseRate",
      "label": "SETE response rate",
      "icon": "message",
      "unit": "percent",
      "target": 70,
      "targetLabel": "≥ 70%",
      "direction": "above",
      "formula": "Completed valid evaluations ÷ eligible student–course evaluation assignments × 100.",
      "title": "Evaluation participation is low",
      "action": "Review access and eligibility issues; interpret the available feedback cautiously.",
      "context": "A student can evaluate several courses. This counts evaluation assignments, not distinct students. The evaluation window is closed in this scenario; open windows should say participation in progress."
    },
    {
      "id": "meanRating",
      "label": "Mean SETE rating",
      "icon": "star",
      "unit": "rating",
      "target": 4,
      "targetLabel": "≥ 4.00 / 5",
      "direction": "above",
      "formula": "Total valid item-score points ÷ valid item responses in completed fifteen-item evaluations.",
      "title": "Teaching feedback warrants review",
      "action": "Discuss dimension results, participation and supporting evidence with the faculty member.",
      "context": "All fifteen items have equal weight. The dimensions have six, five and four items. A rating is student perception, not a complete measure of effectiveness; do not use it alone for personnel decisions."
    },
    {
      "id": "difficultyRate",
      "label": "Academic difficulty rate",
      "icon": "alert",
      "unit": "percent",
      "target": 10,
      "targetLabel": "≤ 10%",
      "direction": "below",
      "formula": "Distinct students with at least one finalized failed course ÷ students with at least one finalized pass/fail outcome × 100.",
      "title": "Academic support may be needed",
      "action": "Validate failed-course records and arrange confidential advising or learning support.",
      "context": "Each student is counted once. This describes recorded academic outcomes; it is not a prediction of future failure or a judgment of student ability."
